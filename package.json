{
  "name": "@igloczek/astro-bun-adapter",
  "version": "0.1.0",
  "description": "Run Astro SSR on Bun's native HTTP server",
  "type": "module",
  "license": "MIT",
  "author": "Igloczek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Igloczek/astro-bun-adapter.git"
  },
  "bugs": "https://github.com/Igloczek/astro-bun-adapter/issues",
  "homepage": "https://github.com/Igloczek/astro-bun-adapter#readme",
  "keywords": [
    "astro",
    "astro-adapter",
    "bun",
    "ssr"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server.js": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./preview.js": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun run scripts/integration.ts",
    "test:package": "bun run scripts/package-check.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:package",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:unit && bun run build && bun run test:package",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "astro": "7.1.6",
    "oxlint": "1.76.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "astro": {
    "external": true
  }
}
